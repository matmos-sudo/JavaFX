<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="450.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.bankaccount.HelloController">
   <top>
      <VBox spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label text="Starting balance:" />
                  <TextField fx:id="startBalanceField" prefWidth="120.0" />
                  <Button mnemonicParsing="false" onAction="#createAccount" text="Create Account" />
                  <Label text="Balance:" />
                  <Label fx:id="balanceLabel" style="-fx-font-weight: bold;" text="0.00 €" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label text="Type:" />
                  <ComboBox fx:id="typeCombo" prefWidth="110.0" />
                  <Label text="Sum:" />
                  <TextField fx:id="sumField" prefWidth="80.0" />
                  <Button mnemonicParsing="false" onAction="#runOne" text="Run client" />
                  <Button mnemonicParsing="false" onAction="#runFive" text="Run 5 clients" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </top>
   <center>
      <VBox spacing="5.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="Transactions:" />
            <TextArea fx:id="transactionsArea" prefHeight="330.0" prefWidth="630.0" />
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>
