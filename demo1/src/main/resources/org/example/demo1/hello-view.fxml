    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <Pane fx:id="root" prefHeight="338.0" prefWidth="462.0">
      <children>
         <Button layoutX="11.0" layoutY="9.0" mnemonicParsing="false" onAction="#Draw" prefHeight="26.0" prefWidth="62.0" text="Draw" />
          <Button layoutX="14.0" layoutY="41.0" onAction="#Manual" text="Manual" />
         <Button layoutX="4.0" layoutY="66.0" mnemonicParsing="false" onAction="#Automatic" text="Automatic" />
      </children>
   </Pane>

    <Label fx:id="welcomeText" />
